функ на_слова(текст)
    слово := ""
    слова := ()
    для индекс от 0 до (#текст - 1) цикл
        если текст[индекс] == " " то
            слова = слова + (слово,)
            слово = ""
        иначе
            слово = слово + текст[индекс]

    слова = слова + (слово,)

    возврат слова

функ индекс_слова(стог, иголка)
    если #иголка == 0 то возврат 0

    для индекс от 0 до (#стог - #иголка) цикл
        если стог[индекс:индекс + #иголка] == иголка то возврат индекс

    возврат -1

функ индекс_символа(стог, иголка)
    для индекс от 0 до (#стог - 1) цикл
        если иголка == стог[индекс] то возврат индекс

    возврат -1
