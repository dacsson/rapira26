\ Типы суммы
тип Дерево
    ДПустое
    ДВетка(левое, правое)

функ создать_дерево(глубина)
    если глубина == 0 то
        возврат ДПустое

    глубина := глубина - 1

    возврат ДВетка(создать_дерево(глубина), создать_дерево(глубина))

функ проверка_дерева(веточка)
    выбор веточка
        при ДПустое: возврат 1
        при ДВетка(лев, прав):
            возврат 1 + проверка_дерева(лев) + проверка_дерева(прав)

функ найти_макс_глубину(мин, глуб)
    если мин + 2 > глуб то
        возврат мин + 2
    иначе
        возврат глуб

мин_глубина := 4
ввод: глубина
макс_глубина := найти_макс_глубину(мин_глубина, глубина)
стретч := макс_глубина + 1

вывод бпс: "стретч дерево глубиной ", стретч
вывод: " проверил: ", проверка_дерева(создать_дерево(стретч))

старое_дерево := создать_дерево(макс_глубина)

итераций := 2 ** макс_глубина
для глуб от мин_глубина до (стретч - 1) шаг 2 цикл
    поверка_деревьев := 0

    повтор итераций цикл
        поверка_деревьев = (поверка_деревьев
                                + проверка_дерева(создать_дерево(глуб))
                            )

    вывод: итераций, " деревьев глубиной ", глуб, " поверили ", поверка_деревьев
    итераций = итераций // 4

вывод: "старое дерево глубиной ", макс_глубина, " поверили ", проверка_дерева(старое_дерево)
