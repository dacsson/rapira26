\ The Computer Language Benchmarks Game reverse-complement benchmark.

\ Put the common DNA bases first because this lookup runs in Rapira.
исходные := "atcgGCATRHWDSYMVKNBUbdhkmnsruwvy"
дополнения := "TAGCCGTAYDWHSRKBMNVAVHDMKNSYAWBR"

функ индекс_символа(стог, иголка)
    для индекс от 0 до #стог - 1 цикл
        если стог[индекс] == иголка то возврат индекс
    возврат -1

функ дополнение(символ)
    индекс := индекс_символа(исходные, символ)
    если индекс == -1 то возврат символ
    возврат дополнения[индекс]

функ показать(заголовок, строки)
    вывод: заголовок

    \ Input lines are prepended to this linked tuple, so walking it naturally
    \ visits the sequence lines in reverse order. Walking each line backwards
    \ then gives the reverse of the complete sequence without first copying it
    \ into one enormous contiguous text value.
    буфер := " " * 60
    позиция := 0
    пока не тип_пуст(строки) цикл
        строка := строки[0]
        индекс := #строка - 1
        пока индекс >= 0 цикл
            буфер[позиция] = дополнение(строка[индекс])
            позиция = позиция + 1
            если позиция == 60 то
                вывод: буфер
                позиция = 0
            индекс = индекс - 1
        строки = строки[1]

    если позиция > 0 то
        вывод: буфер[:позиция]

заголовок := ""
строки := пусто
читать := да
пока читать цикл
    \ `ввод текста` performs one buffered, line-oriented read. An empty result
    \ marks EOF for valid FASTA input, which does not contain blank data lines.
    ввод текста: строка
    если строка == "" то
        читать = нет
    иначе если строка[0] == ">" то
        если заголовок /= "" то
            показать(заголовок, строки)
        заголовок = строка
        строки = пусто
    иначе
        строки = (строка, строки)

если заголовок /= "" то
    показать(заголовок, строки)
