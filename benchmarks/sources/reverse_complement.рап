\ The Computer Language Benchmarks Game reverse-complement benchmark.

функ дополнение(символ)
    если символ == "A" или символ == "a" то возврат "T"
    если символ == "C" или символ == "c" то возврат "G"
    если символ == "B" или символ == "b" то возврат "V"
    если символ == "D" или символ == "d" то возврат "H"
    если символ == "G" или символ == "g" то возврат "C"
    если символ == "H" или символ == "h" то возврат "D"
    если символ == "K" или символ == "k" то возврат "M"
    если символ == "M" или символ == "m" то возврат "K"
    если символ == "N" или символ == "n" то возврат "N"
    если символ == "S" или символ == "s" то возврат "S"
    если символ == "R" или символ == "r" то возврат "Y"
    если символ == "U" или символ == "u" то возврат "A"
    если символ == "T" или символ == "t" то возврат "A"
    если символ == "W" или символ == "w" то возврат "W"
    если символ == "V" или символ == "v" то возврат "B"
    если символ == "Y" или символ == "y" то возврат "R"
    возврат символ

функ показать(заголовок, строки)
    вывод: заголовок

    \ Input lines are prepended to this linked tuple, so walking it naturally
    \ visits the sequence lines in reverse order. Walking each line backwards
    \ then gives the reverse of the complete sequence without first copying it
    \ into one enormous contiguous text value.
    буфер := ""
    пока не тип_пуст(строки) цикл
        строка := строки[0]
        индекс := #строка - 1
        пока индекс >= 0 цикл
            буфер = буфер + дополнение(строка[индекс])
            если #буфер == 60 то
                вывод: буфер
                буфер = ""
            индекс = индекс - 1
        строки = строки[1]

    если #буфер > 0 то
        вывод: буфер

заголовок := ""
строки := пусто
читать := да
пока читать цикл
    \ `ввод текста` performs one buffered, line-oriented read. An empty result
    \ marks EOF for valid FASTA input, which does not contain blank data lines.
    ввод текста: строка
    если строка == "" то
        читать = нет
    иначе
        если строка[0] == ">" то
            если заголовок /= "" то
                показать(заголовок, строки)
            заголовок = строка
            строки = пусто
        иначе
            строки = (строка, строки)

если заголовок /= "" то
    показать(заголовок, строки)
